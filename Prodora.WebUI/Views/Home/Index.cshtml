@model ProductListModel
@{ ViewData["Title"] = "İyi seçimler, her gün"; }
<partial name="_slider" />
<div class="benefit-strip"><span><svg class="icon"><use href="#i-grid" /></svg>Farklı markalar, tek adres</span><span><svg class="icon"><use href="#i-bag" /></svg>Kolay alışveriş deneyimi</span><span><svg class="icon"><use href="#i-box" /></svg>Siparişlerin bir arada</span></div>
<div class="section-heading"><div><span class="eyebrow">MAĞAZAYI KEŞFET</span><h2>Seçimini yap, tarzını tamamla.</h2></div><a class="text-link" href="/products">Tüm ürünleri gör <svg class="icon"><use href="#i-arrow" /></svg></a></div>
<div class="catalog-layout">
    <aside class="catalog-sidebar">@await Component.InvokeAsync("CategoryList")</aside>
    <section aria-label="Ürünler">
        @if (Model.Products?.Any() == true)
        { <div class="product-grid">@foreach (var product in Model.Products.Take(12)) { <partial name="_products" model="product" /> }</div> }
        else
        { <div class="empty-state"><svg class="icon"><use href="#i-box" /></svg><h2>Koleksiyon hazırlanıyor</h2><p>Ürünler eklendiğinde burada görüntülenecek.</p></div> }
    </section>
</div>
