@model ProductListModel
@{ ViewData["Title"] = "Ürün yönetimi"; }
<div class="page-heading"><div><h1>Ürünler</h1><p>Mağazanın ürünlerini görüntüle ve düzenle.</p></div><a asp-action="CreateProduct" class="btn btn-primary">+ Yeni ürün</a></div>
@if (Model.Products?.Any() == true)
{ <div class="table-shell"><table class="table"><thead><tr><th>Ürün</th><th>Marka</th><th>Fiyat</th><th>Stok</th><th class="text-end">İşlemler</th></tr></thead><tbody>@foreach (var item in Model.Products)
{ <tr><td><a class="table-product" asp-controller="@(item.IsArchived ? "Admin" : "Shop")" asp-action="@(item.IsArchived ? "EditProduct" : "Details")" asp-route-id="@item.Id"><img src="~/img/@(item.Images.FirstOrDefault()?.ImageUrl ?? "product-placeholder.svg")" alt="" /><strong>@item.Name</strong></a></td><td>@item.Brand</td><td class="text-nowrap">@item.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) TL</td><td><span class="badge-soft">@(item.IsArchived ? "Arşivde" : item.Stock ? "Stokta" : "Stokta yok")</span></td><td><div class="table-actions"><a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Düzenle</a><form asp-action="@(item.IsArchived ? "RestoreProduct" : "DeleteProduct")" method="post" data-confirm="Ürünün mağazada görünme durumunu değiştirmek istiyor musun?"><input name="productId" type="hidden" value="@item.Id" /><button class="btn btn-danger btn-sm" type="submit">@(item.IsArchived ? "Yayına al" : "Arşivle")</button></form></div></td></tr> }
</tbody></table></div> }
else { <div class="empty-state"><svg class="icon"><use href="#i-box" /></svg><h2>İlk ürününü ekle.</h2><p>Eklediğin ürünler mağazanda listelenir.</p><a asp-action="CreateProduct" class="btn btn-primary">Yeni ürün oluştur</a></div> }
