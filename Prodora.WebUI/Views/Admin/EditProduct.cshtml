@using Prodora.Entitys
@model ProductModel
@{ ViewData["Title"] = "Ürün düzenle"; }
<div class="page-heading"><div><h1>Ürünü düzenle</h1><p>@Model.Name</p></div><a asp-action="ProductList" class="text-link">Ürünlere dön ↗</a></div>
<form asp-action="EditProduct" method="post" enctype="multipart/form-data" class="admin-form">
<input asp-for="Id" type="hidden" /><input asp-for="CategoryId" type="hidden" /><div asp-validation-summary="All"></div>
<div class="admin-form-layout"><section class="panel"><div class="panel-heading"><h2>Ürün bilgileri</h2></div><partial name="_ProductFields" model="Model" /></section>
<aside class="panel"><h2 class="h5 mb-4">Kategoriler</h2><div class="checkbox-list">@foreach (var category in (List<Category>)ViewBag.Categories) { <label><input name="categoryIds" type="checkbox" value="@category.Id" checked="@(Model.SelectedCategories?.Any(c => c.Id == category.Id) == true)" />@category.Name</label> }</div><hr /><h2 class="h5 mb-3">Görseller</h2><div class="image-previews">@foreach (var image in Model.Images) { <img src="~/img/@image.ImageUrl" alt="@Model.Name" /> }</div><div class="form-field"><label for="product-files">Yeni görsel ekle</label><input id="product-files" name="files" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" multiple data-image-preview /><span class="form-hint">Mevcut görseller korunur. Dosya başına en fazla 5 MB.</span></div><div class="image-previews" data-image-previews></div></aside></div>
<div class="form-actions"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button><a asp-action="ProductList" class="btn btn-secondary">Vazgeç</a></div></form>
