@model CategoryListModel
@{ ViewData["Title"] = "Kategori yönetimi"; }
<div class="page-heading"><div><h1>Kategoriler</h1><p>Ürünlerini kolay keşfedilen gruplara ayır.</p></div><a asp-action="CreateCategory" class="btn btn-primary">+ Yeni kategori</a></div>
@if (Model.Categories?.Any() == true)
{ <div class="table-shell"><table class="table"><thead><tr><th>Kategori no</th><th>Kategori adı</th><th class="text-end">İşlemler</th></tr></thead><tbody>@foreach (var item in Model.Categories) { <tr><td>#@item.Id</td><td><strong>@item.Name</strong></td><td><div class="table-actions"><a asp-action="EditCategory" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Düzenle</a><form asp-action="DeleteCategory" method="post" data-confirm="Bu kategoriyi silmek istiyor musun?"><input name="categoryId" type="hidden" value="@item.Id" /><button type="submit" class="btn btn-danger btn-sm">Sil</button></form></div></td></tr> }</tbody></table></div> }
else { <div class="empty-state"><svg class="icon"><use href="#i-grid" /></svg><h2>Henüz kategori yok.</h2><p>Ürünlerin için ilk kategoriyi oluştur.</p><a asp-action="CreateCategory" class="btn btn-primary">Kategori oluştur</a></div> }
