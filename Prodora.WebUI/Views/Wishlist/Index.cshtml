@using Prodora.Entitys
@model List<Product>
@{ ViewData["Title"] = "Favorilerim"; }
<div class="page-heading"><div><span class="eyebrow">HESABIM</span><h1>Favorilerim</h1><p>Beğendiğin ürünler burada bekler.</p></div><a href="/products" class="text-link">Mağazaya dön ↗</a></div>
@if (Model.Count == 0)
{ <div class="empty-state"><svg class="icon"><use href="#i-heart" /></svg><h2>Henüz favorin yok.</h2><p>Ürün kartlarındaki kalbe dokunarak beğendiklerini buraya ekleyebilirsin.</p><a href="/products" class="btn btn-primary">Ürünlere göz at</a></div> }
else
{ <div class="product-grid">@foreach (var product in Model) { <partial name="_products" model="product" /> }</div> }
