@model ProductDetail
@{ ViewData["Title"] = Model.Products.Name; var product = Model.Products; var images = product.Images ?? new List<Prodora.Entitys.Image>(); var plainDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(product.Description ?? "", "<.*?>", "")); }
<nav class="breadcrumb-nav" aria-label="İçerik yolu"><a href="/">Ana sayfa</a><span>/</span><a href="/products">Mağaza</a><span>/</span><span>@product.Name</span></nav>
<section class="product-detail">
    <div class="product-gallery">
        <div class="gallery-main"><img id="main-image" src="@(images.Any() ? Url.Content("~/img/" + images[0].ImageUrl) : Url.Content("~/img/product-placeholder.svg"))" alt="@product.Name" /></div>
        @if (images.Count > 1)
        { <div class="gallery-thumbs" aria-label="Ürün görselleri">@for (var i = 0; i < images.Count; i++) { <button type="button" class="@(i == 0 ? "active" : "")" data-gallery-image="@Url.Content("~/img/" + images[i].ImageUrl)" aria-label="@(i + 1). ürün görseli" aria-pressed="@(i == 0 ? "true" : "false")"><img src="~/img/@images[i].ImageUrl" alt="" /></button> }</div> }
    </div>
    <div class="product-info">
        <span class="product-brand">@product.Brand</span><h1>@product.Name</h1>
        <div class="product-price">@product.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) <span>TL</span></div>
        <div class="category-tags">@foreach (var category in Model.Categories) { <a asp-action="List" asp-route-category="@category.Name">@category.Name</a> }</div>
        <div class="product-description">@plainDescription</div>
        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("admin"))
        {
            <form class="product-actions" asp-controller="Basket" asp-action="AddToBasket" method="post">
                <input type="hidden" name="productId" value="@product.Id" />
                <div class="quantity-field"><label for="quantity">Adet</label><input id="quantity" class="form-control" type="number" name="quantity" min="1" max="99" value="1" required /></div>
                <button type="submit" name="action" value="addToBasket" class="btn btn-accent"><svg class="icon"><use href="#i-bag" /></svg>Sepete ekle</button>
                <button type="submit" name="action" value="buyNow" class="btn btn-secondary">Hemen al</button>
            </form>
        }
        else if (User.IsInRole("admin"))
        { <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-primary">Ürünü düzenle</a> }
        else
        { <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary btn-block">Alışveriş için giriş yap</a> }
        <span class="form-hint">Fiyatlar Türk lirası cinsindendir.</span>
    </div>
</section>
<div class="product-tabs" role="tablist" aria-label="Ürün bilgileri">
    <button class="tab-button active" type="button" role="tab" id="description-tab-button" aria-controls="description-tab" aria-selected="true" data-tab="description-tab">Ürün hakkında</button>
    <button class="tab-button" type="button" role="tab" id="comments-tab-button" aria-controls="comments-tab" aria-selected="false" tabindex="-1" data-tab="comments-tab">Değerlendirmeler (@Model.Comments.Count)</button>
</div>
<section id="description-tab" class="tab-pane active prose" role="tabpanel" aria-labelledby="description-tab-button">@plainDescription</section>
<section id="comments-tab" class="tab-pane" role="tabpanel" aria-labelledby="comments-tab-button"><partial name="_PartialComments" model="Model.Comments" view-data='new ViewDataDictionary(ViewData) { { "ProductId", product.Id } }' /></section>
@if (Model.RelatedProducts.Any())
{ <div class="section-heading"><div><span class="eyebrow">KEŞFETMEYE DEVAM ET</span><h2>Bunları da beğenebilirsin.</h2></div><a href="/products" class="text-link">Tüm ürünler ↗</a></div><div class="product-grid">@foreach (var related in Model.RelatedProducts) { <partial name="_products" model="related" /> }</div> }
