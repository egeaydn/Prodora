@model ProductListModel
@{ ViewData["Title"] = string.IsNullOrEmpty(Model.SearchTerm) ? "Tüm ürünler" : "Arama sonuçları"; }
<nav class="breadcrumb-nav" aria-label="İçerik yolu"><a href="/">Ana sayfa</a><span>/</span><span>Mağaza</span></nav>
<div class="page-heading"><div><span class="eyebrow">PRODORA KOLEKSİYONU</span><h1>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? (string.IsNullOrWhiteSpace(Model.PageInfo.CurrentCategory) || Model.PageInfo.CurrentCategory == "all" ? "Tüm ürünler" : Model.PageInfo.CurrentCategory) : "“" + Model.SearchTerm + "” için sonuçlar")</h1><p>@Model.PageInfo.TotalItems ürün arasından sana uygun olanı bul.</p></div></div>
<div class="catalog-layout">
    <aside class="catalog-sidebar">@await Component.InvokeAsync("CategoryList")</aside>
    <section aria-label="Ürün listesi">
        <form class="catalog-toolbar" action="/products" method="get">
            <input type="hidden" name="category" value="@Model.PageInfo.CurrentCategory" /><input type="hidden" name="q" value="@Model.SearchTerm" />
            <span>@Model.PageInfo.CurrentPage. sayfa</span>
            <div><label for="product-sort">Sıralama</label><select id="product-sort" name="sort" class="form-select" data-auto-submit>
                <option value="newest" selected="@(Model.Sort == "newest")">En yeni ürünler</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Fiyat: düşükten yükseğe</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Fiyat: yüksekten düşüğe</option><option value="name" selected="@(Model.Sort == "name")">Ürün adı: A–Z</option>
            </select><button class="btn btn-secondary sort-submit" type="submit">Uygula</button></div>
        </form>
        @if (Model.Products?.Any() == true)
        {
            <div class="product-grid">@foreach (var product in Model.Products) { <partial name="_products" model="product" /> }</div>
            @if (Model.PageInfo.TotalPages() > 1)
            {
                <nav class="pagination-nav" aria-label="Ürün sayfaları">
                @for (var pageNumber = Math.Max(1, Model.PageInfo.CurrentPage - 2); pageNumber <= Math.Min(Model.PageInfo.TotalPages(), Model.PageInfo.CurrentPage + 2); pageNumber++)
                { <a href="@Url.Action("List", "Shop", new { category = Model.PageInfo.CurrentCategory, page = pageNumber, q = Model.SearchTerm, sort = Model.Sort })" class="@(pageNumber == Model.PageInfo.CurrentPage ? "active" : "")" aria-current="@(pageNumber == Model.PageInfo.CurrentPage ? "page" : null)">@pageNumber</a> }
                </nav>
            }
        }
        else
        { <div class="empty-state"><svg class="icon"><use href="#i-search" /></svg><h2>Aradığın ürünü bulamadık</h2><p>Farklı bir kelime deneyebilir veya diğer kategorilere göz atabilirsin.</p><a href="/products" class="btn btn-primary">Tüm ürünlere dön</a></div> }
    </section>
</div>
