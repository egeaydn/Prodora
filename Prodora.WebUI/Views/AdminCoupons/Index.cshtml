@using Prodora.Entitys
@model List<Coupon>
@{
    ViewData["Title"] = "Kuponlar";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}
<partial name="_AdminNav" />
<div class="page-heading"><div><span class="eyebrow">MAĞAZA YÖNETİMİ</span><h1>Kuponlar</h1><p>Her müşteri bir kuponu bir kez kullanabilir. Ödeme başarısız olur veya sipariş iptal edilirse kullanım hakkı geri verilir.</p></div></div>
<section class="panel">
    <div class="panel-heading"><h2>Yeni kupon</h2></div>
    <form asp-action="Create" method="post" class="form-grid">
        <div class="form-field"><label for="code">Kod</label><input id="code" name="code" class="form-control" maxlength="32" required placeholder="YAZ25" /></div>
        <div class="form-field"><label for="kind">Tür</label><select id="kind" name="kind" class="form-control"><option value="0">Yüzde (%)</option><option value="1">Sabit tutar (TL)</option></select></div>
        <div class="form-field"><label for="value">Değer</label><input id="value" name="value" type="number" step="0.01" min="0.01" class="form-control" required /></div>
        <div class="form-field"><label for="minSubtotal">En az sepet tutarı (TL)</label><input id="minSubtotal" name="minSubtotal" type="number" step="0.01" min="0" value="0" class="form-control" /></div>
        <div class="form-field"><label for="expiresAt">Son gün <span class="text-muted">(isteğe bağlı)</span></label><input id="expiresAt" name="expiresAt" type="date" class="form-control" /></div>
        <div class="form-field"><label for="maxRedemptions">Toplam kullanım sınırı <span class="text-muted">(isteğe bağlı)</span></label><input id="maxRedemptions" name="maxRedemptions" type="number" min="1" class="form-control" /></div>
        <div class="form-field full-width"><button type="submit" class="btn btn-primary">Kuponu oluştur</button></div>
    </form>
</section>
@if (!Model.Any())
{ <div class="empty-state"><h2>Henüz kupon yok.</h2></div> }
else
{
<section class="panel">
    <table class="data-table">
        <thead><tr><th>Kod</th><th>İndirim</th><th>En az sepet</th><th>Son gün</th><th>Kullanım</th><th>Durum</th><th></th></tr></thead>
        <tbody>
        @foreach (var coupon in Model)
        {
            <tr>
                <td><strong>@coupon.Code</strong></td>
                <td>@(coupon.Kind == CouponKind.Percent ? $"%{coupon.Value:0}" : $"{coupon.Value.ToString("N2", culture)} TL")</td>
                <td>@(coupon.MinSubtotal > 0 ? coupon.MinSubtotal.ToString("N2", culture) + " TL" : "—")</td>
                <td>@(coupon.ExpiresAt is { } end ? end.AddDays(-1).ToString("dd.MM.yyyy") : "—")</td>
                <td>@coupon.RedemptionCount@(coupon.MaxRedemptions is { } max ? $" / {max}" : "")</td>
                <td><span class="badge-soft">@(coupon.IsActive ? "Aktif" : "Kapalı")</span></td>
                <td><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@coupon.Id" /><input type="hidden" name="isActive" value="@((!coupon.IsActive).ToString().ToLowerInvariant())" /><button type="submit" class="btn btn-secondary">@(coupon.IsActive ? "Kapat" : "Aç")</button></form></td>
            </tr>
        }
        </tbody>
    </table>
</section>
}
