@model ResetPasswordModel
@{ ViewData["Title"] = "Yeni şifre belirle"; }
<div class="auth-shell">
    <partial name="_AuthAside" />
    <section class="auth-content">
        <h1>Yeni şifre belirle</h1>
        <p>Hesabın için güçlü bir şifre seç.</p>
        <form asp-controller="Account" asp-action="ResetPassword" method="post" asp-antiforgery="true">
            <div asp-validation-summary="All" role="alert"></div>
            <input asp-for="Token" type="hidden" />
            <div class="form-field">
                <label asp-for="Email">E-posta adresi</label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" required />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password">Yeni şifre</label>
                <div class="password-field">
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required aria-describedby="password-hint" />
                    <button type="button" class="password-toggle" data-password-toggle aria-label="Yeni şifreyi göster">Göster</button>
                </div>
                <span asp-validation-for="Password"></span>
                <span id="password-hint" class="form-hint">En az 6 karakter; büyük ve küçük harf, rakam ve özel karakter kullan.</span>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Şifremi güncelle</button>
        </form>
        <div class="auth-links">
            <a asp-action="ForgotPassword">Yeni bağlantı iste</a>
            <a asp-action="Login">Giriş sayfasına dön</a>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
