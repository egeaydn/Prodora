@model ResetPasswordModel
@{ ViewData["Title"] = "Yeni şifre belirle"; }
<div class="auth-shell"><partial name="_AuthAside" /><section class="auth-content"><h1>Yeni şifre belirle</h1><p>Hesabın için güçlü bir şifre seç.</p><div asp-validation-summary="ModelOnly"></div><form asp-action="ResetPassword" method="post"><input asp-for="Token" type="hidden" /><div class="form-field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="Password">Yeni şifre</label><div class="password-field"><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle aria-label="Yeni şifre göster">Göster</button></div><span asp-validation-for="Password"></span></div><button class="btn btn-primary btn-block" type="submit">Şifremi güncelle</button></form><div class="auth-links"><a asp-action="Login">Giriş sayfasına dön</a></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
