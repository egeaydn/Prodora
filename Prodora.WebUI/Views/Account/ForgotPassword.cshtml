@{ ViewData["Title"] = "Şifremi unuttum"; }
<div class="auth-shell"><partial name="_AuthAside" /><section class="auth-content"><h1>Şifremi unuttum</h1><p>Hesabına kayıtlı e-posta adresini yaz. Şifreni yenilemen için bağlantı gönderelim.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-field"><label for="reset-email">E-posta adresi</label><input id="reset-email" name="email" type="email" class="form-control" autocomplete="email" required /></div><button class="btn btn-primary btn-block" type="submit">Yenileme bağlantısı gönder</button></form><div class="auth-links"><a asp-action="Login">Giriş sayfasına dön</a></div></section></div>