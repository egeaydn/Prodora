@model RegisterPage
@{ ViewData["Title"] = "Hesap oluştur"; }
<div class="auth-shell"><partial name="_AuthAside" /><section class="auth-content"><h1>Hesap oluştur</h1><p>Birkaç bilgiyle Prodora'ya katıl.</p><div asp-validation-summary="ModelOnly"></div><form asp-action="Register" method="post"><div class="form-field"><label asp-for="FullName">Ad soyad</label><input asp-for="FullName" type="text" class="form-control" autocomplete="name" required /><span asp-validation-for="FullName"></span></div><div class="form-field"><label asp-for="UserName">Kullanıcı adı</label><input asp-for="UserName" type="text" class="form-control" autocomplete="username" required /><span asp-validation-for="UserName"></span></div><div class="form-field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="Password">Şifre</label><div class="password-field"><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle aria-label="Şifre göster">Göster</button></div><span asp-validation-for="Password"></span></div><p class="form-hint">En az 6 karakter; büyük ve küçük harf, rakam ve özel karakter kullan.</p><div class="form-field"><label asp-for="RePassword">Şifre tekrar</label><div class="password-field"><input asp-for="RePassword" type="password" class="form-control" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle aria-label="Şifre tekrar göster">Göster</button></div><span asp-validation-for="RePassword"></span></div><button class="btn btn-primary btn-block" type="submit">Hesap oluştur</button></form><div class="auth-links"><span>Zaten hesabın var mı?</span><a asp-action="Login">Giriş yap</a></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
