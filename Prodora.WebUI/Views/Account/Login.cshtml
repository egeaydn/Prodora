@model LoginModel
@{ ViewData["Title"] = "Giriş yap"; }
<div class="auth-shell"><partial name="_AuthAside" /><section class="auth-content"><h1>Giriş yap</h1><p>Alışverişine kaldığın yerden devam et.</p><div asp-validation-summary="ModelOnly"></div><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden" /><div class="form-field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="Password">Şifre</label><div class="password-field"><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required /><button type="button" class="password-toggle" data-password-toggle aria-label="Şifre göster">Göster</button></div><span asp-validation-for="Password"></span></div><button class="btn btn-primary btn-block" type="submit">Giriş yap <svg class="icon"><use href="#i-arrow" /></svg></button></form><div class="auth-links"><a asp-action="ForgotPassword">Şifremi unuttum</a><a asp-action="Register">Hesap oluştur</a></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
