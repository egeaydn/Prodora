@model AccountModel
@{ ViewData["Title"] = "Hesabım"; }
<div class="page-heading"><div><span class="eyebrow">SANA AİT BİR ALAN</span><h1>Hesabım</h1><p>Hesap bilgilerini ve siparişlerini tek yerden yönet.</p></div></div>
<div class="account-layout">
<aside class="account-nav"><a asp-action="Manage" class="active">Hesap bilgilerim</a><a asp-controller="Basket" asp-action="GetOrders">Siparişlerim</a><a asp-controller="Basket" asp-action="Home">Alışveriş sepetim</a><a asp-action="ForgotPassword">Şifre yenile</a><form asp-action="Logout" method="post"><button class="btn btn-secondary btn-sm" type="submit">Çıkış yap</button></form></aside>
<section class="panel"><div class="panel-heading"><h2>Hesap bilgileri</h2><svg class="icon"><use href="#i-user" /></svg></div><form asp-action="Manage" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-field"><label asp-for="FullName">Ad soyad</label><input asp-for="FullName" type="text" class="form-control" autocomplete="name" required /><span asp-validation-for="FullName"></span></div><div class="form-field"><label asp-for="UserName">Kullanıcı adı</label><input asp-for="UserName" type="text" class="form-control" autocomplete="username" required /><span asp-validation-for="UserName"></span></div><div class="form-field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="CurrentPassword">Mevcut şifre</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span><small>E-posta değişikliği için gereklidir. Yeni adresini onaylayana kadar mevcut adresin geçerli kalır.</small></div><div class="form-actions"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button><a href="/products" class="btn btn-secondary">Alışverişe dön</a></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
