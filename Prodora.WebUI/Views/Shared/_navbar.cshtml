@{ var signedIn = User.Identity?.IsAuthenticated == true; }
<header class="site-header">
    <div class="header-main shell">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Prodora ana sayfa"><partial name="_BrandLogo" /></a>
        <form class="header-search" action="/products" method="get" role="search">
            <label class="visually-hidden" for="store-search">Ürün veya marka ara</label>
            <input id="store-search" name="q" value="@Context.Request.Query["q"]" placeholder="Ne aramıştınız?" type="search" maxlength="100" autocomplete="off" />
            <button type="submit" aria-label="Ara"><svg class="icon"><use href="#i-search" /></svg></button>
        </form>
        <nav class="header-actions" aria-label="Hesap ve sepet">
            <a asp-controller="Account" asp-action="@(signedIn ? "Manage" : "Login")" class="header-action"><svg class="icon"><use href="#i-user" /></svg><span><small>@(signedIn ? "Hoş geldiniz" : "Merhaba, giriş yapın")</small><strong>Hesabım</strong></span></a>
            <a asp-controller="Basket" asp-action="GetOrders" class="header-action orders-link"><span><small>Geçmiş alışverişler</small><strong>Siparişlerim</strong></span></a>
            <a asp-controller="Basket" asp-action="Home" class="header-action bag-link"><svg class="icon"><use href="#i-bag" /></svg><strong>Sepetim</strong></a>
        </nav>
    </div>
    <div class="header-nav"><nav class="shell nav-strip" aria-label="Ana menü">
        <a href="/products" class="nav-all"><svg class="icon"><use href="#i-grid" /></svg>Tüm ürünler</a>
        <a asp-controller="Tools" asp-action="About">Prodora'yı keşfet</a><a asp-controller="Tools" asp-action="Help">Yardım merkezi</a><a asp-controller="Tools" asp-action="Contact">İletişim</a>
        @if (User.IsInRole("admin")) { <a asp-controller="Admin" asp-action="ProductList">Mağaza yönetimi</a> }
        <span class="nav-note">İyi seçimler, her gün.</span>
    </nav></div>
</header>
