@model CategoryListViewModel
<details class="category-panel" open>
    <summary>Kategoriler <svg class="icon"><use href="#i-grid" /></svg></summary>
    <nav aria-label="Ürün kategorileri">
        <a href="/products" class="@(string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory == "all" ? "active" : "")">Tüm ürünler <span>↗</span></a>
        @foreach (var category in Model.Categories)
        { <a asp-controller="Shop" asp-action="List" asp-route-category="@category.Name" class="@(string.Equals(Model.SelectedCategory, category.Name, StringComparison.OrdinalIgnoreCase) ? "active" : "")">@category.Name <span>›</span></a> }
    </nav>
</details>
<div class="sidebar-note"><span class="eyebrow">BİRAZ İLHAM</span><p>Güzel bir gün,<br />iyi bir seçimle başlar.</p><a asp-controller="Tools" asp-action="About">Prodora'yı tanı ↗</a></div>
