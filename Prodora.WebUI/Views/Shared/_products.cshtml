@using Prodora.Entitys
@model Product
@{
    var image = Model.Images?.FirstOrDefault()?.ImageUrl;
    var description = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(Model.Description ?? "", "<.*?>", ""));
}
<article class="product-card">
    <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="product-image" tabindex="-1" aria-hidden="true"><img src="@(string.IsNullOrWhiteSpace(image) ? Url.Content("~/img/product-placeholder.svg") : Url.Content("~/img/" + image))" alt="" loading="lazy" /></a>
    <div class="product-card-body">
        <span class="product-brand">@Model.Brand</span>
        <h3><a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3>
        <p class="product-excerpt">@description</p>
        <div class="product-price">@Model.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) <span>TL</span></div>
        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("admin"))
        {
            <form asp-controller="Basket" asp-action="AddToBasket" method="post"><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="quantity" value="1" /><button class="btn btn-cart" type="submit" disabled="@(!Model.Stock || Model.IsArchived)"><svg class="icon"><use href="#i-bag" /></svg>@(Model.Stock ? "Sepete ekle" : "Stokta yok")</button></form>
        }
        else
        { <a class="product-more" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">Ürünü incele <svg class="icon"><use href="#i-arrow" /></svg></a> }
    </div>
</article>
