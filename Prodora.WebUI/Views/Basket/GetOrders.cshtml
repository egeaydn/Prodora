@model List<OrderListModel>
@{
    ViewData["Title"] = "Siparişlerim"; var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    string Status(Prodora.Entitys.OrderStatus value) => value switch { Prodora.Entitys.OrderStatus.Pending => "Ödeme bekleniyor", Prodora.Entitys.OrderStatus.Processing => "Hazırlanıyor", Prodora.Entitys.OrderStatus.Shipped => "Kargoya verildi", Prodora.Entitys.OrderStatus.Delivered => "Teslim edildi", Prodora.Entitys.OrderStatus.Cancelled => "İptal edildi", Prodora.Entitys.OrderStatus.Completed => "Tamamlandı", Prodora.Entitys.OrderStatus.PaymentPending => "Ödeme sonucu bekleniyor", Prodora.Entitys.OrderStatus.PaymentFailed => "Ödeme onaylanmadı", Prodora.Entitys.OrderStatus.PaymentUncertain => "Ödeme kontrol edilmeli", _ => value.ToString() };
}
<div class="page-heading"><div><span class="eyebrow">HESABIM</span><h1>Siparişlerim</h1><p>Alışverişlerin ve sipariş detayların bir arada.</p></div><a href="/products" class="text-link">Mağazaya dön ↗</a></div>
@if (Model?.Any() == true)
{
@foreach (var order in Model.OrderByDescending(o => o.OrderDate))
{
<details class="order-card">
    <summary><div><small>Sipariş tarihi</small><strong>@order.OrderDate.ToString("dd MMMM yyyy", culture)</strong></div><div><small>Sipariş no</small><strong>#@order.OrderId.ToString("D6")</strong></div><div><small>Toplam tutar</small><strong>@order.TotalPrice().ToString("N2", culture) TL</strong></div><span class="badge-soft">@Status(order.OrderStatusEnums)</span><span aria-hidden="true">⌄</span></summary>
    <div class="order-content"><section><h3>Siparişindeki ürünler</h3>@foreach (var item in order.OrderItems) { <div class="summary-product"><img src="~/img/@item.ImageUrl" alt="@item.Name" /><div><strong>@item.Name</strong><small>@item.Quantity adet · @item.Price.ToString("N2", culture) TL</small></div><strong>@((item.Quantity * item.Price).ToString("N2", culture)) TL</strong></div> }</section>
    <section><h3>Teslimat ve ödeme</h3><dl class="order-address"><dt>Alıcı</dt><dd>@order.FirstName @order.LastName</dd><dt>Adres</dt><dd>@order.Adress, @order.City</dd><dt>İletişim</dt><dd>@order.Phone<br />@order.Email</dd><dt>Ödeme yöntemi</dt><dd>@(order.OrderPamentsEnum == Prodora.Entitys.OrderPayments.CreditCard ? "Kredi / banka kartı" : "Havale / EFT")</dd><dt>Sipariş referansı</dt><dd>@order.OrderNumber</dd>@if (!string.IsNullOrWhiteSpace(order.OrderNote)) { <dt>Sipariş notu</dt><dd>@order.OrderNote</dd> }</dl></section></div>
</details>
}
}
else
{ <div class="empty-state"><svg class="icon"><use href="#i-box" /></svg><h2>İlk siparişine yer ayırdık.</h2><p>Henüz bir siparişin yok. Yeni favorilerini keşfetmek için mağazaya göz at.</p><a href="/products" class="btn btn-primary">Alışverişe başla</a></div> }
