@model BasketModel
@{ ViewData["Title"] = "Alışveriş sepetim"; var items = Model.BasketItems ?? new List<BasketItemModel>(); var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR"); }
<nav class="breadcrumb-nav"><a href="/products">Mağaza</a><span>/</span><span>Sepetim</span></nav>
<div class="page-heading"><div><span class="eyebrow">İYİ SEÇİMLERİN BURADA</span><h1>Alışveriş sepetim</h1><p>Sepetinde @items.Sum(i => i.Quantity) ürün var.</p></div><a href="/products" class="text-link">Alışverişe devam et ↗</a></div>
@if (items.Any())
{
<div class="basket-layout"><section class="panel" aria-label="Sepetteki ürünler">@foreach (var item in items)
{ <article class="basket-row"><img src="~/img/@item.Image" alt="@item.ProductName" /><div><h2>@if (item.IsAvailable) { <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a> } else { @item.ProductName }</h2>@if (!item.IsAvailable) { <p class="text-danger">Bu ürün şu anda satın alınamıyor. Sepetten kaldırarak devam edebilirsin.</p> }<p>@item.Quantity adet · @item.Price.ToString("N2", culture) TL / adet</p><form asp-action="DeleteFromBasket" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="link-button" type="submit">Sepetten kaldır</button></form></div><div class="line-total">@((item.Price * item.Quantity).ToString("N2", culture)) TL</div></article> }
</section><aside class="panel order-summary"><h2>Sipariş özeti</h2><div class="summary-line"><span>Ürünler (@items.Sum(i => i.Quantity))</span><span>@Model.TotalPrice().ToString("N2", culture) TL</span></div><div class="summary-line"><span>Kargo</span><span>Ücretsiz</span></div><div class="summary-line summary-total"><span>Toplam</span><strong>@Model.TotalPrice().ToString("N2", culture) TL</strong></div><a asp-action="Checkout" class="btn btn-primary btn-block">Ödemeye geç <svg class="icon"><use href="#i-arrow" /></svg></a><span class="form-hint">Kart işlemleri iyzico test ortamında gerçekleştirilir.</span></aside></div>
}
else
{ <div class="empty-state"><svg class="icon"><use href="#i-bag" /></svg><h2>Sepetin yeni seçimlerini bekliyor.</h2><p>Koleksiyona göz at, beğendiğin parçaları sepetine ekle.</p><a href="/products" class="btn btn-primary">Ürünleri keşfet</a></div> }
